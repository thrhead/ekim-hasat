generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ApplicationUser {
  id                String   @id @default(uuid()) @db.Uuid
  authProvider      String   @map("auth_provider")
  authSubject       String   @map("auth_subject")
  defaultBusinessId String?  @map("default_business_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  defaultBusiness      Business?                        @relation("DefaultBusiness", fields: [defaultBusinessId], references: [id], onDelete: Restrict)
  memberships          Membership[]
  completions          OnboardingCompletion[]
  idempotencyRecords   IdempotencyRecord[]
  seasonCommandRecords SeasonCommandIdempotencyRecord[]
  taskCompletions      TaskCompletion[]                 @relation("CompletionActorUser")

  @@unique([authProvider, authSubject])
  @@index([defaultBusinessId])
  @@map("application_users")
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  defaultUsers ApplicationUser[]      @relation("DefaultBusiness")
  memberships  Membership[]
  fields       Field[]
  completions  OnboardingCompletion[]
  customCrops  CustomCrop[]
  seasons      Season[]
  weatherSnapshots WeatherSnapshot[]

  @@map("businesses")
}

model Membership {
  id         String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  role       String
  status     String

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            ApplicationUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskCompletions TaskCompletion[]

  @@unique([businessId, userId])
  @@unique([id, businessId, userId])
  @@index([userId, businessId, status])
  @@map("memberships")
}

model Field {
  id                  String                              @id @default(uuid()) @db.Uuid
  businessId          String                              @map("business_id") @db.Uuid
  name                String
  representativePoint Unsupported("geometry(Point,4326)") @map("representative_point")
  createdAt           DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  version             Int                                 @default(1)

  business           Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  boundaryVersions   FieldBoundaryVersion[]
  completions        OnboardingCompletion[]
  idempotencyRecords IdempotencyRecord[]
  seasons            Season[]
  taskCompletions    TaskCompletion[]
  weatherSnapshot    WeatherSnapshot?
  weatherRefreshState WeatherRefreshState?

  @@unique([id, businessId])
  @@index([businessId])
  @@map("fields")
}

model WeatherSnapshot {
  id                  String   @id @default(uuid()) @db.Uuid
  businessId          String   @map("business_id") @db.Uuid
  fieldId             String   @map("field_id") @db.Uuid
  representativePoint Unsupported("geometry(Point,4326)") @map("representative_point")
  locationFingerprint String   @map("location_fingerprint")
  businessTimezone    String   @map("business_timezone")
  coverageStart       DateTime @map("coverage_start") @db.Timestamptz(6)
  coverageEnd         DateTime @map("coverage_end") @db.Timestamptz(6)
  forecastLocalDates  String[] @map("forecast_local_dates")
  fetchedAt           DateTime @map("fetched_at") @db.Timestamptz(6)
  refreshStartedAt    DateTime @map("refresh_started_at") @db.Timestamptz(6)
  providerIssuedAt    DateTime? @map("provider_issued_at") @db.Timestamptz(6)
  qualityStatus       String   @default("ACCEPTED") @map("quality_status")
  observedAt          DateTime @map("observed_at") @db.Timestamptz(6)
  conditionCode       String   @map("condition_code")
  conditionLabel      String?  @map("condition_label")
  temperatureC        Float    @map("temperature_c")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  field    Field                  @relation(fields: [fieldId, businessId], references: [id, businessId], onDelete: Restrict)
  dailyForecasts WeatherDailyForecast[]

  @@unique([fieldId, businessId])
  @@index([businessId, fetchedAt])
  @@map("weather_snapshots")
}

model WeatherRefreshState {
  businessId      String   @map("business_id") @db.Uuid
  fieldId         String   @map("field_id") @db.Uuid
  lastAttemptedAt DateTime @map("last_attempted_at") @db.Timestamptz(6)
  lastAttemptOrder BigInt  @default(autoincrement()) @map("last_attempt_order") @db.BigInt

  field Field @relation(fields: [fieldId, businessId], references: [id, businessId], onDelete: Cascade)

  @@id([fieldId, businessId])
  @@index([lastAttemptOrder])
  @@map("weather_refresh_states")
}

model WeatherDailyForecast {
  id                         String   @id @default(uuid()) @db.Uuid
  snapshotId                 String   @map("snapshot_id") @db.Uuid
  localDate                  DateTime @map("local_date") @db.Date
  conditionCode              String   @map("condition_code")
  conditionLabel             String?  @map("condition_label")
  temperatureHighC           Float    @map("temperature_high_c")
  temperatureLowC            Float    @map("temperature_low_c")
  precipitationChancePercent Float    @map("precipitation_chance_percent")
  windSpeedKph               Float    @map("wind_speed_kph")

  snapshot WeatherSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, localDate])
  @@index([localDate])
  @@map("weather_daily_forecasts")
}

model FieldBoundaryVersion {
  id                 String                                @id @default(uuid()) @db.Uuid
  fieldId            String                                @map("field_id") @db.Uuid
  version            Int
  geometry           Unsupported("geometry(Polygon,4326)")
  verificationStatus String                                @default("UNVERIFIED") @map("verification_status")
  createdAt          DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)

  field           Field                   @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  seasonSnapshots SeasonContextSnapshot[]

  @@index([fieldId])
  @@map("field_boundary_versions")
}

model OnboardingCompletion {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  defaultBusinessId String   @map("default_business_id") @db.Uuid
  fieldId           String   @map("field_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user            ApplicationUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  defaultBusiness Business        @relation(fields: [defaultBusinessId], references: [id], onDelete: Restrict)
  field           Field           @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([userId, defaultBusinessId])
  @@index([fieldId])
  @@map("onboarding_completions")
}

model IdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  key                String
  payloadFingerprint String   @map("payload_fingerprint")
  fieldId            String   @map("field_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)

  user  ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  field Field           @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([userId, key])
  @@index([expiresAt])
  @@index([fieldId])
  @@map("idempotency_records")
}

// Immutable runtime crop definitions; availability may change without rewriting content.
model CropDefinitionVersion {
  id             String  @id @default(uuid()) @db.Uuid
  cropKey        String  @map("crop_key")
  version        String
  displayName    String  @map("display_name")
  productionType String? @map("production_type")
  selectable     Boolean @default(true)

  seasons   Season[]
  templates ValidatedTemplateVersion[]

  @@unique([cropKey, version])
  @@unique([id, cropKey])
  @@map("crop_definition_versions")
}

model CustomCrop {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  seasons  Season[]

  @@unique([id, businessId])
  @@index([businessId])
  @@map("custom_crops")
}

model ValidatedTemplateVersion {
  id                      String  @id @default(uuid()) @db.Uuid
  templateKey             String  @map("template_key")
  version                 String
  cropDefinitionVersionId String  @map("crop_definition_version_id") @db.Uuid
  regionSelector          String? @map("region_selector")
  taskDefinitions         Json    @map("task_definitions")
  published               Boolean @default(true)
  available               Boolean @default(true)

  cropDefinitionVersion CropDefinitionVersion   @relation(fields: [cropDefinitionVersionId], references: [id], onDelete: Restrict)
  plans                 SeasonPlan[]
  snapshots             SeasonContextSnapshot[]

  @@unique([templateKey, version])
  @@index([cropDefinitionVersionId, available])
  @@map("validated_template_versions")
}

model Season {
  id                      String    @id @default(uuid()) @db.Uuid
  businessId              String    @map("business_id") @db.Uuid
  fieldId                 String    @map("field_id") @db.Uuid
  cropKey                 String?   @map("crop_key")
  cropDefinitionVersionId String?   @map("crop_definition_version_id") @db.Uuid
  customCropId            String?   @map("custom_crop_id") @db.Uuid
  actualPlantingDate      DateTime  @map("actual_planting_date") @db.Date
  status                  String    @default("DRAFT")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt             DateTime? @map("activated_at") @db.Timestamptz(6)

  business              Business                         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  field                 Field                            @relation(fields: [fieldId, businessId], references: [id, businessId], onDelete: Restrict)
  cropDefinitionVersion CropDefinitionVersion?           @relation(fields: [cropDefinitionVersionId, cropKey], references: [id, cropKey], onDelete: Restrict)
  customCrop            CustomCrop?                      @relation(fields: [customCropId, businessId], references: [id, businessId], onDelete: Restrict)
  plan                  SeasonPlan?
  snapshot              SeasonContextSnapshot?
  commandRecords        SeasonCommandIdempotencyRecord[]
  taskCompletions       TaskCompletion[]

  // Partial unique indexes for CENTRAL and CUSTOM logical identities are migration-owned.
  @@unique([id, businessId])
  @@unique([id, businessId, fieldId])
  @@index([businessId, status])
  @@index([fieldId])
  @@map("seasons")
}

model SeasonPlan {
  id                String  @id @default(uuid()) @db.Uuid
  seasonId          String  @unique @map("season_id") @db.Uuid
  source            String
  templateVersionId String? @map("template_version_id") @db.Uuid
  sourceSnapshot    Json    @map("source_snapshot")
  status            String  @default("DRAFT")

  season          Season                    @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  templateVersion ValidatedTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  tasks           PlannedTask[]
  completions     TaskCompletion[]

  @@unique([id, seasonId])
  @@index([templateVersionId])
  @@map("season_plans")
}

model PlannedTask {
  id                    String   @id @default(uuid()) @db.Uuid
  seasonPlanId          String   @map("season_plan_id") @db.Uuid
  title                 String
  description           String?
  plannedLocalDate      DateTime @map("planned_local_date") @db.Date
  sourceTemplateTaskKey String?  @map("source_template_task_key")
  version               Int      @default(1)

  seasonPlan SeasonPlan      @relation(fields: [seasonPlanId], references: [id], onDelete: Restrict)
  completion TaskCompletion?

  @@unique([id, seasonPlanId])
  @@index([seasonPlanId, plannedLocalDate])
  @@map("planned_tasks")
}

model SeasonContextSnapshot {
  seasonId               String   @id @map("season_id") @db.Uuid
  fieldBoundaryVersionId String?  @map("field_boundary_version_id") @db.Uuid
  regionContext          Json?    @map("region_context")
  cropSnapshot           Json     @map("crop_snapshot")
  source                 String
  templateVersionId      String?  @map("template_version_id") @db.Uuid
  activatedAt            DateTime @map("activated_at") @db.Timestamptz(6)
  businessTimezone       String   @map("business_timezone")
  activatedLocalDate     DateTime @map("activated_local_date") @db.Date

  season               Season                    @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  fieldBoundaryVersion FieldBoundaryVersion?     @relation(fields: [fieldBoundaryVersionId], references: [id], onDelete: Restrict)
  templateVersion      ValidatedTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  taskCompletions      TaskCompletion[]

  @@index([fieldBoundaryVersionId])
  @@index([templateVersionId])
  @@map("season_context_snapshots")
}

model TaskCompletion {
  id                       String   @id @db.Uuid
  plannedTaskId            String   @unique(map: "task_completions_planned_task_id_key") @map("planned_task_id") @db.Uuid
  seasonPlanId             String   @map("season_plan_id") @db.Uuid
  seasonId                 String   @map("season_id") @db.Uuid
  fieldId                  String   @map("field_id") @db.Uuid
  businessId               String   @map("business_id") @db.Uuid
  actorUserId              String   @map("actor_user_id") @db.Uuid
  actorMembershipId        String   @map("actor_membership_id") @db.Uuid
  occurredAt               DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt               DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  baseTaskVersion          Int      @map("base_task_version")
  payloadFingerprint       String   @map("payload_fingerprint")
  taskTitleSnapshot        String   @map("task_title_snapshot")
  plannedLocalDateSnapshot DateTime @map("planned_local_date_snapshot") @db.Date

  plannedTask        PlannedTask           @relation(fields: [plannedTaskId, seasonPlanId], references: [id, seasonPlanId], onDelete: Restrict)
  seasonPlan         SeasonPlan            @relation(fields: [seasonPlanId, seasonId], references: [id, seasonId], onDelete: Restrict)
  season             Season                @relation(fields: [seasonId, businessId, fieldId], references: [id, businessId, fieldId], onDelete: Restrict)
  field              Field                 @relation(fields: [fieldId, businessId], references: [id, businessId], onDelete: Restrict)
  activationSnapshot SeasonContextSnapshot @relation(fields: [seasonId], references: [seasonId], onDelete: Restrict)
  actorUser          ApplicationUser       @relation("CompletionActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership    Membership            @relation(fields: [actorMembershipId, businessId, actorUserId], references: [id, businessId, userId], onDelete: Restrict)

  @@unique([plannedTaskId, seasonPlanId])
  @@index([fieldId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([seasonId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([businessId])
  @@map("task_completions")
}

model SeasonCommandIdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  command            String
  key                String
  payloadFingerprint String   @map("payload_fingerprint")
  seasonId           String   @map("season_id") @db.Uuid
  result             Json
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)

  user   ApplicationUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  season Season          @relation(fields: [seasonId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([userId, businessId, command, key], map: "season_commands_user_business_command_key")
  @@index([seasonId])
  @@index([expiresAt])
  @@map("season_command_idempotency_records")
}
