# Local development only; use local PostgreSQL started by `docker compose up -d postgres`.
DATABASE_URL=postgresql://ekim_hasat:ekim_hasat_local@localhost:5432/ekim_hasat
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

# Expo mobile configuration: publishable client key only; never use a service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/v1

# These values configure only the local PostgreSQL container in compose.yaml.
POSTGRES_DB=ekim_hasat
POSTGRES_USER=ekim_hasat
POSTGRES_PASSWORD=ekim_hasat_local
POSTGRES_PORT=5432
